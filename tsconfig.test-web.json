{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "test/web/**/*.ts",
    "test/web/**/*.tsx",
    "src/web/**/*.ts",
    "src/web/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
